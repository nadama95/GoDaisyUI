package dropdown

import (
	"fmt"
	"github.com/Oudwins/tailwind-merge-go/pkg/twmerge"
	"github.com/nadama95/godaisyui/ui/actions/button"
)

const (
	baseClass         = "dropdown"
	baseItemListClass = "dropdown menu w-52 rounded-box bg-base-100 shadow-sm"
)

type Props struct {
	Classes string
	Placement
	Modifier
}

func NewProps() *Props {
	return &Props{
		Classes:   "",
		Placement: PlacementBottom,
		Modifier:  ModifierDefault,
	}
}

templ Root(id, toggleName string, props *Props, attrs templ.Attributes, buttonProps *button.Props) {
	@button.Root(buttonProps, templ.Attributes{"popovertarget": id, "style": fmt.Sprintf("anchor-name:--anchor-%s", id)}) {
		{ toggleName }
	}
	@list(templ.Attributes{"id": id, "style": fmt.Sprintf("position-anchor:--anchor-%s", id)}) {
		{ children... }
	}
}

templ list(attrs templ.Attributes) {
	<ul class={ twmerge.Merge(baseItemListClass) } popover { attrs... }>
		{ children... }
	</ul>
}

templ Item() {
	<li>
		<a>
			{ children... }
		</a>
	</li>
}
